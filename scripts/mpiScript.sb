#!/bin/bash
#SBATCH --job-name="mpi"
#SBATCH --output="mpiShortestPath.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --mem=1G
#SBATCH --account=isu103
#SBATCH --export=ALL
#SBATCH -t 00:30:00

#Run the job
./mpi -np 1 graphs/ingredient-net.smat 0
./mpi -np 5 graphs/ingredient-net.smat 0
./mpi -np 10 graphs/ingredient-net.smat 0
./mpi -np 20 graphs/ingredient-net.smat 0
./mpi -np 50 graphs/ingredient-net.smat 0
