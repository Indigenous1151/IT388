#!/bin/bash
#SBATCH --job-name="omp"
#SBATCH --output="ompShortestPath.%j.%N.out"
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --mem=1G
#SBATCH --account=isu103
#SBATCH --export=ALL
#SBATCH -t 00:30:00

#Run the job
./omp 1 ../graphs/ingredient-net.smat 0
./omp 5 ../graphs/ingredient-net.smat 0
./omp 10 ../graphs/ingredient-net.smat 0
./omp 20 ../graphs/ingredient-net.smat 0
./omp 40 ../graphs/ingredient-net.smat 0
